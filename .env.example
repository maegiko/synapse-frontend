# Base URL of the Synapse backend. Defaults to http://localhost:8080 when unset.
# The backend's CORS config currently only allows the dev origin http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8080

# The Google OAuth Web application client ID, the same value the backend gets as
# GOOGLE_CLIENT_ID. Not a secret; it ships in the bundle. Leave it unset and the
# "Continue with Google" button is hidden rather than shown broken.
VITE_GOOGLE_CLIENT_ID=

# Optional product analytics. Leave both unset locally to disable event capture.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
